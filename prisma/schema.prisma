generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String?
  isActive  Boolean  @default(true)
  isSystemAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Legacy relations (will be store-scoped gradually)
  products                    Product[]
  activityLogs                ActivityLog[]
  settings                    UserSettings[]
  marketplaceConnections      MarketplaceConnection[]
  productMarketplaceMappings  ProductMarketplaceMapping[]
  importJobs                  ImportJob[]
  xmlFeedSources              XmlFeedSource[]
  trendyolPublishJobs         TrendyolPublishJob[]
  trendyolFinanceSyncRuns     TrendyolFinanceSyncRun[]
  systemReferenceSyncLogs     SystemReferenceSyncLog[]

  // Store memberships
  storeMemberships            StoreMembership[]
  invitedMemberships          StoreMembership[] @relation("InvitedBy")
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("active") // active/inactive
  plan      String?
  timezone  String?
  currency  String   @default("TRY")
  locale    String   @default("tr-TR")
  featureFlags Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships StoreMembership[]
  activityLogs ActivityLog[]
  products Product[]
  importJobs ImportJob[]
  xmlFeedSources XmlFeedSource[]
  marketplaceConnections MarketplaceConnection[]
  userSettings UserSettings[]
  trendyolPublishJobs TrendyolPublishJob[]
  productMarketplaceMappings ProductMarketplaceMapping[]
  productMarketplaceAttributes ProductMarketplaceAttribute[]
  marketplaceOrders           MarketplaceOrder[]
  marketplaceOrderLines       MarketplaceOrderLine[]
  marketplaceOrderEvents      MarketplaceOrderEvent[]
  marketplaceOrderInvoices   MarketplaceOrderInvoice[]
  marketplaceOrderTrackingEvents MarketplaceOrderTrackingEvent[]
  marketplaceOrderShippingEvents MarketplaceOrderShippingEvent[]
  storeRolePermissions       StoreRolePermission[]
  orderSyncJobs              OrderSyncJob[]
  storeOrderSyncStates       StoreOrderSyncState[]
  marketplaceReturnClaims     MarketplaceReturnClaim[]
  marketplaceReturnClaimLines MarketplaceReturnClaimLine[]
  marketplaceReturnClaimEvents MarketplaceReturnClaimEvent[]
  trendyolReturnReasons       TrendyolReturnReason[]
  trendyolFinanceSyncRuns     TrendyolFinanceSyncRun[]
  trendyolFinanceLines        TrendyolFinanceLine[]
  marketplaceCarriers         MarketplaceCarrier[]
  marketplaceBrands           MarketplaceBrand[]
  marketplaceCategories       MarketplaceCategory[]
  marketplaceAttributes       MarketplaceAttribute[]
  /// Maliyet fiyatı aralığına göre komisyon/kargo/kâr oranı tanımları (kademeli fiyatlandırma).
  pricingTiers PricingTier[]
  /// Ürün/fiyat/stok bazlı pazaryeri gönderim kısıtlaması (mağaza başına tek kayıt).
  publishRule MarketplacePublishRule?
  /// Buybox'a göre otomatik yeniden fiyatlandırma ayarları (mağaza başına tek kayıt).
  buyboxRepricingSettings BuyboxRepricingSettings?

  @@index([status])
}

/// Belirlenen eşiklerin dışında kalan ürünlerin Trendyol'a gönderilmesini engelleyen kurallar.
/// Mağaza başına tek kayıt (@@unique storeId); tüm alanlar opsiyonel, null = kısıtlama yok.
model MarketplacePublishRule {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Bu stok sayısının altındaki ürünler gönderilmez (null = kontrol yok)
  minStock  Int?
  /// Bu fiyatın altındaki ürünler gönderilmez (null = kontrol yok)
  minPrice  Float?
  /// Bu fiyatın üstündeki ürünler gönderilmez (null = kontrol yok)
  maxPrice  Float?

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId])
}

/// Buybox'a göre otomatik yeniden fiyatlandırma stratejisi (mağaza başına tek kayıt).
/// Gerçek fiyat değişikliği sadece isActive=true VE ürün bazında
/// ProductMarketplaceMapping.autoRepriceEnabled=true olan ürünlerde uygulanır (çift opt-in güvenliği).
model BuyboxRepricingSettings {
  id               String   @id @default(uuid()) @db.Uuid
  storeId          String   @db.Uuid
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  isActive         Boolean  @default(false)

  /// "undercut_amount" | "undercut_percent" | "match_buybox"
  strategy         String   @default("undercut_amount")
  /// strategy=undercut_amount için ₺, undercut_percent için % değeri
  undercutValue    Float    @default(1)
  /// Maliyet üzerinden korunacak minimum kâr yüzdesi (opsiyonel güvenlik tabanı) — null ise kontrol yok
  minMarginPct     Float?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([storeId])
}

/// Maliyet fiyatı aralığına göre komisyon oranı, kargo bedeli ve hedef kâr oranı tanımı.
/// Ürün bazlı override (Product.commissionRate/cargoCost/targetProfitRate) varsa o öncelikli;
/// yoksa maliyet fiyatı bu aralıklardan birine düşüyorsa buradaki değerler kullanılır.
model PricingTier {
  id               String   @id @default(uuid()) @db.Uuid
  storeId          String   @db.Uuid
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Görünen isim, örn. "0-100 TL" (opsiyonel, otomatik üretilebilir)
  label            String?
  /// Aralığın alt sınırı (dahil), maliyet fiyatına göre
  minCostPrice     Float
  /// Aralığın üst sınırı (dahil); null ise "ve üzeri" anlamına gelir
  maxCostPrice     Float?

  commissionRate   Float
  cargoCost        Float
  targetProfitRate Float

  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([storeId, isActive, minCostPrice])
}

/// Mağaza başına Trendyol kargo firması referansı (API sync → DB, UI tek kaynak).
model MarketplaceCarrier {
  id               String    @id @default(uuid()) @db.Uuid
  storeId          String    @db.Uuid
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform         String    @default("TRENDYOL")
  code             String
  name             String
  isActive         Boolean   @default(true)
  metadata         Json?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([storeId, platform, code])
  @@index([storeId, platform, isActive])
}

/// Global kargo sağlayıcı referansı (store bağımsız; Trendyol providerCode listesi).
model MarketplaceCarrierReference {
  id           String    @id @default(uuid()) @db.Uuid
  platform     String    @default("trendyol")
  providerCode String
  providerName String
  region       String?
  isActive     Boolean   @default(true)
  rawData      Json?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([platform, providerCode])
  @@index([platform, isActive])
}

/// Trendyol (veya diğer platform) sipariş senkron işi — izlenebilirlik ve retry.
model OrderSyncJob {
  id                   String    @id @default(uuid()) @db.Uuid
  storeId              String    @db.Uuid
  store                Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform             String    @default("trendyol")
  /// Test/sandbox amaçlı sync job ayrımı.
  isTestRecord         Boolean   @default(false)
  testSource           String?
  sandboxMode          Boolean   @default(false)
  /// manual | cron | webhook_reconcile | retry
  syncType             String
  /// queued | running | completed | failed | partial
  status               String    @default("queued")
  startedAt            DateTime?
  finishedAt           DateTime?
  lockUntil            DateTime?
  heartbeatAt          DateTime?
  lastCursorStartDate  DateTime?
  lastCursorEndDate    DateTime?
  packagesFetchedCount Int       @default(0)
  packagesCreatedCount Int       @default(0)
  packagesUpdatedCount Int       @default(0)
  packagesSkippedCount Int       @default(0)
  failedCount          Int       @default(0)
  errorMessage         String?
  attemptCount         Int       @default(0)
  maxAttempts          Int       @default(5)
  nextRetryAt          DateTime?
  /// status filtresi, orderBy, incremental vs reconcile bayrakları (JSON)
  options              Json?
  triggeredByUserId    String?   @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([storeId, platform, status, createdAt])
  @@index([storeId, createdAt])
}

/// Mağaza bazlı son senkron özeti (cron / manuel / webhook ile güncellenir).
model StoreOrderSyncState {
  id                   String    @id @default(uuid()) @db.Uuid
  storeId              String    @db.Uuid
  store                Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform             String    @default("trendyol")
  lastSuccessfulSyncAt DateTime?
  lastAttemptedSyncAt  DateTime?
  lastWebhookSeenAt    DateTime?
  lastReconcileAt      DateTime?
  lastStatus           String?
  lastErrorMessage     String?
  lastJobId            String?   @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([storeId, platform])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions     RolePermission[]
  storeRolePermissions StoreRolePermission[]
  storeMemberships    StoreMembership[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions      RolePermission[]
  membershipOverrides  StoreMembershipPermissionOverride[]
  storeRolePermissions   StoreRolePermission[]
}

/// Mağaza bazlı rol–izin sapması: global RolePermission + bu tablo = etkin izinler.
model StoreRolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  isGranted    Boolean

  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, roleId, permissionId])
  @@index([storeId, roleId])
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model StoreMembership {
  id              String   @id @default(uuid()) @db.Uuid
  storeId         String   @db.Uuid
  userId          String   @db.Uuid
  roleId          String   @db.Uuid
  isActive        Boolean  @default(true)
  invitedByUserId String?  @db.Uuid

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id])
  invitedByUser User? @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  permissionOverrides StoreMembershipPermissionOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId])
  @@index([userId, storeId])
  @@index([storeId, roleId])
}

model StoreMembershipPermissionOverride {
  id           String  @id @default(uuid()) @db.Uuid
  membershipId String  @db.Uuid
  permissionId String  @db.Uuid
  isAllowed    Boolean

  membership StoreMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([membershipId, permissionId])
}

model XmlFeedSource {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId             String   @db.Uuid
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                String
  feedUrl             String
  isActive            Boolean  @default(true)
  syncIntervalMinutes Int      @default(60)
  lastSyncedAt        DateTime?
  lastSyncStatus      String?
  lastSyncMessage     String?
  lastSyncProductsUpdated Int?
  lastSyncSkippedCount    Int?
  lastSyncPublishedCount  Int?
  lastSyncInventoryPushCount Int?
  /// Feed'de artık yoksa ürünü stok 0 + taslak yap
  deactivateMissingFromFeed Boolean @default(false)
  /// Doluysa, bu feed'den gelen tüm ürülerde XML'deki marka yerine bu sabit marka yazılır.
  overrideBrandName   String?
  /// Doluysa, bu feed'den gelen ürünler Trendyol'a yayınırken mağaza varsayılanı yerine
  /// bu sevkiyat/iade adresi ID'leri kullanılır (örn. farklı depo/tedarikçiden gelen feed).
  shipmentAddressId   String?
  returnAddressId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, isActive, updatedAt])
  @@index([storeId, isActive, updatedAt])
}

model ImportJob {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId          String   @db.Uuid
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  sourceType       String
  originalFileName String
  status           String   @default("pending")
  usageStatus      String   @default("active")
  totalRows        Int      @default(0)
  successRows      Int      @default(0)
  failedRows       Int      @default(0)
  // İçe aktarmada seçildiyse tüm satırlarda normalizedBrand bununla yazılır (dosyadaki markayı ezer).
  overrideBrandName String?

  rows ImportRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, usageStatus, createdAt])
  @@index([storeId, usageStatus, createdAt])
}

model ImportRow {
  id                     String    @id @default(uuid()) @db.Uuid
  importJobId            String    @db.Uuid
  importJob              ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  rowIndex               Int
  rawData                Json

  normalizedName         String?
  normalizedDescription  String?
  normalizedBrand        String?
  normalizedCategoryText String?
  normalizedSku          String?
  normalizedBarcode      String?
  mainImageUrl           String?
  imageUrls              Json?
  price                  Float?
  stock                  Int?

  status                 String    @default("pending")
  errorMessage           String?

  marketplaceSuggestions ImportRowMarketplaceSuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importJobId, rowIndex])
}

model ImportRowMarketplaceSuggestion {
  id                         String   @id @default(uuid()) @db.Uuid
  importRowId                String   @db.Uuid
  importRow                  ImportRow @relation(fields: [importRowId], references: [id], onDelete: Cascade)

  platform                   String   @default("trendyol")
  suggestedBrandId           Int?
  suggestedBrandName         String?
  suggestedCategoryId        Int?
  suggestedCategoryName      String?
  confidenceScore            Float?
  aiReasoningSummary         String?
  missingRequiredAttributes  Json?
  status                     String   @default("suggested")

  suggestedAttributes ImportRowMarketplaceSuggestedAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([importRowId, platform])
  @@index([importRowId])
}

model ImportRowMarketplaceSuggestedAttribute {
  id                String   @id @default(uuid()) @db.Uuid
  suggestionId      String   @db.Uuid
  suggestion        ImportRowMarketplaceSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  attributeId       Int
  attributeName     String
  attributeValueId  Int?
  attributeValue    String?
  customValue       String?
  isRequired        Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([suggestionId, attributeId])
}

model UserSettings {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @db.Uuid
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId                 String   @db.Uuid
  store                   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  companyName             String?
  defaultCurrency         String   @default("TRY")
  defaultVatRate          Float    @default(20)
  defaultCommissionRate   Float?
  defaultCargoCost        Float?
  defaultTargetProfitRate Float?
  defaultDesi             Float    @default(1)
  fallbackBrand           String?
  fallbackCategory        String?
  /// XML/içe aktarmadan gelen barkodlara eklenecek ön ek (örn. "MPX-"). Boşsa hiçbir şey eklenmez.
  xmlBarcodePrefix        String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([storeId])
  @@index([userId, storeId])
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId        String   @db.Uuid
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  price          Decimal
  stock          Int

  // Yeni alanlar
  category       String?
  brand          String?
  sku            String?
  /// XML feed'inden okunan barkod (mapping oluşturulmadan önce bile eşleşme yapabilmek için)
  barcode        String?
  status         String   @default("draft")
  lifecycleStatus String  @default("draft")
  mainImageUrl   String?
  imageUrls      Json?
  archivedAt     DateTime?
  publishedAt    DateTime?
  unpublishedAt  DateTime?
  seoDescription String?
  tags           String?
  sourceImportJobId String? @db.Uuid
  sourceImportRowId String? @db.Uuid
  createdFromImport Boolean @default(false)
  /// Bu ürün hangi XML feed kaynağından oluşturuldu (XmlFeedSource.id, soft reference)
  sourceXmlFeedSourceId String? @db.Uuid

  // Fiyat önerisi alanları
  costPrice        Float?
  commissionRate   Float?
  cargoCost        Float?
  vatRate          Float?
  targetProfitRate Float?

  /// Trendyol createProducts origin alanı (2 harfli ülke kodu, örn. TR)
  origin           String?

  // Demo veri işaretleme
  isDemo         Boolean  @default(false)

  /// XML akıllı senkron: içerik imzası (başlık, açıklama, görseller, marka, sku)
  contentHash    String?
  priceHash      String?
  stockHash      String?

  /// Son XML feed ile panel (DB) güncellemesi
  lastXmlSyncAt  DateTime?
  /// Son Trendyol / marketplace ile hizalama (istek veya batch sonucu)
  lastMarketplaceSyncAt DateTime?
  /// SYNCED | FAILED | PENDING | NOT_APPLICABLE — panel vs marketplace özeti
  marketplaceSyncStatus   String?
  marketplaceSyncError    String?
  marketplaceSyncSource   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  marketplaceMappings ProductMarketplaceMapping[]

  @@index([userId, lifecycleStatus])
  @@index([userId, archivedAt])
  @@index([userId, sourceImportJobId])
  @@index([storeId, lifecycleStatus])
  @@index([storeId, archivedAt])
  @@index([storeId, sourceImportJobId])
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    String   @db.Uuid
  userId     String   @db.Uuid
  membershipId String? @db.Uuid
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String?
  message    String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([storeId, createdAt])
}

model MarketplaceConnection {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId            String    @db.Uuid
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  platform           String    @default("trendyol")
  sellerId           String
  apiKeyEncrypted    String
  apiSecretEncrypted String
  /// Hepsiburada panel "Servis Anahtarı" (opsiyonel, şifreli).
  /// Basic Auth rolü henüz teyit edilmedi — bkz. HEPSIBURADA_DOGRULAMA_BEKLEYEN.md
  serviceKeyEncrypted String?
  userAgent          String
  environment        String    @default("production")
  isActive           Boolean   @default(true)
  lastTestAt         DateTime?

  // Trendyol createProduct: shipmentAddressId / returningAddressId
  shipmentAddressId  String?
  returnAddressId    String?
  /// CHE / settlements API için supplierId; boşsa sellerId sayısal olarak kullanılır.
  cheSupplierId      String?
  /// Ürün yayına gönderiminde kullanılacak varsayılan Trendyol cargoCompanyId.
  defaultCargoCompanyId Int?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([storeId, platform])
  @@index([userId, platform])
  @@index([storeId, platform])
}

model SystemMarketplaceConnection {
  id                 String   @id @default(uuid()) @db.Uuid
  platform           String   @unique
  sellerId           String
  apiKeyEncrypted    String
  apiSecretEncrypted String
  userAgent          String
  environment        String   @default("production")
  isActive           Boolean  @default(true)
  lastSyncAt         DateTime?
  lastSyncStatus     String?
  lastSyncMessage    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SystemReferenceSyncLog {
  id               String   @id @default(uuid()) @db.Uuid
  action           String
  status           String
  summary          Json?
  message          String?
  triggeredByUserId String? @db.Uuid
  triggeredByUser   User?   @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([action, createdAt])
  @@index([status, createdAt])
}

model MarketplaceOrder {
  id                  String    @id @default(uuid()) @db.Uuid
  storeId             String    @db.Uuid
  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform            String    @default("trendyol")
  /// Test/sandbox kayıtları gerçek operasyonlardan ayrılır.
  isTestRecord        Boolean   @default(false)
  testSource          String?
  sandboxMode         Boolean   @default(false)
  orderNumber         String
  /// Trendyol sipariş numarası kökü (split paketlerde üst referans)
  rootOrderNumber     String
  orderDate           DateTime
  shipmentPackageId   String
  /// Trendyol tarafında üst paket id (API alanı varsa)
  parentShipmentPackageId String?
  packageStatus       String?
  packageStatusUpdatedAt DateTime?
  cargoTrackingNumber String?
  cargoTrackingLink   String?
  cargoSenderNumber   String?
  cargoProviderName   String?
  cargoProviderCode   String?
  cargoLabelUrl       String?
  cargoLabelRawData   Json?
  cargoStatusText     String?
  cargoLastEventAt    DateTime?
  cargoLastEventMessage String?
  trackingRawData     Json?
  trackingUpdatedAt   DateTime?
  cargoProviderChangedAt DateTime?
  labelFetchedAt      DateTime?
  /// idle | pending | success | error (panel kargo operasyonları özeti)
  shippingOperationStatus String?
  shippingOperationLastErrorMessage String?
  customerId          String?
  deliveryAddressType String?
  customerFirstName   String?
  customerLastName    String?
  customerEmailMasked String?
  customerPhoneMasked String?
  totalPrice          Float?
  currency            String    @default("TRY")
  invoiceAddress      Json?
  shipmentAddress     Json?
  rawData             Json?
  lastFetchedAt       DateTime?
  invoiceLink         String?
  invoiceNumber       String?
  invoiceDateTime     DateTime?
  invoiceSentAt       DateTime?
  /// pending | sent | failed
  invoiceStatus       String?
  invoiceLastErrorMessage String?
  invoiceRawData      Json?
  /// manual_sync | webhook | operation | split
  lastIngestSource    String?
  splitFromPackageId  String?   @db.Uuid
  splitFromPackage    MarketplaceOrder? @relation("OrderPackageSplit", fields: [splitFromPackageId], references: [id], onDelete: SetNull)
  splitChildPackages  MarketplaceOrder[] @relation("OrderPackageSplit")
  splitDetectedAt     DateTime?
  isSplitPackage      Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lines    MarketplaceOrderLine[]
  events   MarketplaceOrderEvent[]
  invoices       MarketplaceOrderInvoice[]
  trackingEvents MarketplaceOrderTrackingEvent[]
  shippingEvents MarketplaceOrderShippingEvent[]

  @@unique([storeId, platform, shipmentPackageId])
  @@index([storeId, orderDate])
  @@index([storeId, packageStatus])
  @@index([storeId, orderNumber])
  @@index([storeId, rootOrderNumber])
}

