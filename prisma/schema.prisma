enum ProductMappingApprovalState {
  UNAPPROVED
  APPROVED
}

model ProductMarketplaceMapping {
  id                  String   @id @default(uuid()) @db.Uuid
  productId           String   @db.Uuid
  userId              String   @db.Uuid
  storeId             String   @db.Uuid
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  platform            String   @default("trendyol")
  trendyolBrandId     Int?
  trendyolCategoryId  Int?
  barcode             String?
  stockCode           String?
  productMainId       String?
  cargoCompanyId      Int?
  dimensionalWeight   Float?
  currencyType        String   @default("TRY")
  vatRate             Float?
  listPrice           Float?
  salePrice           Float?
  quantity            Int?
  useProductPrice     Boolean  @default(true)
  useProductStock     Boolean  @default(true)
  publishStatus       String   @default("draft")
  approvalState       ProductMappingApprovalState @default(UNAPPROVED)
  /// V2 onaylı içerik güncelleme (content-bulk-update) için Trendyol contentId
  trendyolContentId   Int?
  /// Termin süresi (gün) — Trendyol deliveryOption.deliveryDuration
  deliveryDuration    Int?
  /// "SAME_DAY_SHIPPING" | "FAST_DELIVERY" — seçilirse deliveryDuration=1 olmalı
  fastDeliveryType    String?
  /// Buybox anlık görüntüsü (Trendyol Buybox Kontrol Servisi) — en son kontrolde alınan değerler
  buyboxOrder         Int?
  buyboxPrice         Float?
  hasMultipleSeller   Boolean?
  secondBuyboxPrice   Float?
  thirdBuyboxPrice    Float?
  buyboxCheckedAt     DateTime?
  /// Bu ürün için buybox'a göre otomatik yeniden fiyatlandırma açık mı (varsayılan: kapalı, opt-in)
  autoRepriceEnabled  Boolean  @default(false)
  /// Bu ürüne özel taban fiyat (opsiyonel) — otomatik yeniden fiyatlandırma bu fiyatın altına inmez
  repriceMinPrice     Float?
  publishedAt         DateTime?
  unpublishedAt       DateTime?
  archivedAt          DateTime?
  lastSyncAt          DateTime?
  batchRequestId      String?
  lastErrorMessage    String?

  /// SUCCESS | FAILED | PENDING — son Trendyol publish denemesinin özeti (batch HTTP + senkron)
  lastPublishStatus         String?
  lastPublishErrorCode      String?
  lastPublishErrorMessage   String?
  lastPublishAttemptAt      DateTime?
  lastSuccessfulPublishAt   DateTime?
  lastPublishBatchId        String?
  lastPublishPayloadHash    String?

  mainImageUrl        String?
  imageUrls           Json?

  attributes ProductMarketplaceAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, platform])
  @@index([userId, platform, publishStatus])
  @@index([storeId, platform, publishStatus])
}

