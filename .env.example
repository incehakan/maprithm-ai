DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

NEXTAUTH_SECRET=replace_with_long_random_string
NEXTAUTH_URL=http://localhost:3000

OPENAI_API_KEY=replace_me
ENCRYPTION_KEY=replace_me_base64_32bytes
TRENDYOL_CARGO_COMPANY_IDS=10,11,12

DATABASE_URL=postgresql://postgres:password@localhost:5432/maprithm_ticaret_ai?schema=public

NEXTAUTH_SECRET=please_change_me_to_a_long_random_string
NEXTAUTH_URL=http://localhost:3000

# 32-byte key, base64 (örnek: openssl rand -base64 32)
# Trendyol API Key/Secret şifrelemesi için zorunlu
ENCRYPTION_KEY=

# İsteğe bağlı: Trendyol x-agentname header (varsayılan: oturum e-postası @ öncesi veya Maprithm)
TRENDYOL_AGENT_NAME=

# İsteğe bağlı: Sunucudan çıkan isteklerde x-clientip için sabit IPv4 (proxy yoksa)
TRENDYOL_FALLBACK_CLIENT_IP=

# Trendyol sipariş webhook (POST /api/webhooks/trendyol/orders) imzası — boş bırakılırsa doğrulama yapılmaz
TRENDYOL_ORDER_WEBHOOK_SECRET=

# GET /api/cron/xml-feed-sync — tanımlıysa Authorization: Bearer <CRON_SECRET> zorunlu
CRON_SECRET=

